// Writes src/NetWasm.FSharp.Core/Printf.fs: one method per printf family and
// arity, each with the parameters of the FSharp.Core method it replaces. The
// NetWasm compiler (FSharpPrintfCallRewriter) sends FSharp.Core's printf calls
// to the method of the call's family and arity.
//
//   dotnet fsi eng/generate-fsharp-printf.fsx
open System.IO
open System.Text

let maxArity = 12

/// name, extra generic result parameter?, parameters before the format, State, Residue,
/// Result, family, finish (over s: string)
let families =
    [ "Sprintf", false, "", "unit", "string", "string", "StringFamily.Instance", "id"
      "Failwithf", true, "", "unit", "string", "'Result", "StringFamily.Instance", "(fun s -> failwith s)"
      "Ksprintf", true, "continuation: string -> 'Result, ", "unit", "string", "'Result", "StringFamily.Instance", "continuation"
      "Kbprintf", true, "continuation: unit -> 'Result, builder: StringBuilder, ", "StringBuilder", "unit", "'Result", "BuilderFamily.Instance", "(fun s -> builder.Append s |> ignore; continuation ())"
      "Kfprintf", true, "continuation: unit -> 'Result, writer: TextWriter, ", "TextWriter", "unit", "'Result", "WriterFamily.Instance", "(fun s -> writer.Write s; continuation ())"
      "Bprintf", false, "builder: StringBuilder, ", "StringBuilder", "unit", "unit", "BuilderFamily.Instance", "(fun s -> builder.Append s |> ignore)"
      "Fprintf", false, "writer: TextWriter, ", "TextWriter", "unit", "unit", "WriterFamily.Instance", "(fun s -> writer.Write s)"
      "Fprintfn", false, "writer: TextWriter, ", "TextWriter", "unit", "unit", "WriterFamily.Instance", "(fun s -> writer.WriteLine s)"
      "Printf", false, "", "TextWriter", "unit", "unit", "WriterFamily.Instance", "(fun s -> Console.Out.Write s)"
      "Printfn", false, "", "TextWriter", "unit", "unit", "WriterFamily.Instance", "(fun s -> Console.Out.WriteLine s)"
      "Eprintf", false, "", "TextWriter", "unit", "unit", "WriterFamily.Instance", "(fun s -> Console.Error.Write s)"
      "Eprintfn", false, "", "TextWriter", "unit", "unit", "WriterFamily.Instance", "(fun s -> Console.Error.WriteLine s)" ]

let args n = [ for i in 1 .. n -> sprintf "'A%d" i ]
let printer n result = String.concat " -> " (args n @ [ result ])

let out = StringBuilder()
let line (s: string) = out.AppendLine s |> ignore

line "// Generated by eng/generate-fsharp-printf.fsx. Do not edit."
line "namespace NetWasm.FSharp.Core"
line ""
line "open System"
line "open System.IO"
line "open System.Text"
line ""
line "/// Builds a printf family's curried printer for each arity."
line "[<AbstractClass; Sealed>]"
line "type Curried ="
for n in 0 .. maxArity do
    let generics = String.concat ", " (args n @ [ "'State"; "'Residue"; "'Result" ])
    line (sprintf "    static member Make%d<%s>(format: PrintfFormat<%s, 'State, 'Residue, 'Result>, family: Family<'State, 'Residue>, finish: string -> 'Result) : %s =" n generics (printer n "'Result") (printer n "'Result"))
    if n = 0 then
        line "        finish (Engine.render (Engine.parse format.Value) format.Captures format.CaptureTypes [||] family)"
    else
        line "        let segments = Engine.parse format.Value"
        let parameters = String.concat " " [ for i in 1 .. n -> sprintf "(a%d: 'A%d)" i i ]
        let arguments = String.concat "; " [ for i in 1 .. n -> sprintf "ArgOf<'A%d, 'State, 'Residue>(a%d) :> Arg<'State, 'Residue>" i i ]
        line (sprintf "        fun %s -> finish (Engine.render segments null null [| %s |] family)" parameters arguments)
line ""
line "/// The printf families, one method per arity, with the parameters of FSharp.Core's."
line "[<AbstractClass; Sealed>]"
line "type Printf ="
for (name, hasResult, before, state, residue, result, family, finish) in families do
    // FSharp.Core's arity-0 method returns its type parameter 'T (= unit), a value on
    // the stack; an F# unit method returns void. So these take 'T too.
    if result = "unit" then
        line (sprintf "    static member %s0<'T>(%sformat: PrintfFormat<'T, %s, %s, %s>) : 'T =" name before state residue result)
        line (sprintf "        Curried.Make0<%s, %s, %s>(unbox<PrintfFormat<unit, %s, %s, %s>> (box format), %s, %s)" state residue result state residue result family finish)
        line "        Unchecked.defaultof<'T>"
    for n in (if result = "unit" then 1 else 0) .. maxArity do
        let generics = args n @ (if hasResult then [ "'Result" ] else [])
        let genericText = if generics.IsEmpty then "" else "<" + String.concat ", " generics + ">"
        let makeGenerics = String.concat ", " (args n @ [ state; residue; result ])
        line (sprintf "    static member %s%d%s(%sformat: PrintfFormat<%s, %s, %s, %s>) : %s =" name n genericText before (printer n result) state residue result (printer n result))
        line (sprintf "        Curried.Make%d<%s>(format, %s, %s)" n makeGenerics family finish)

let path = Path.Combine(__SOURCE_DIRECTORY__, "..", "src", "NetWasm.FSharp.Core", "Printf.fs")
File.WriteAllText(path, out.ToString())
printfn "wrote %s" (Path.GetFullPath path)
