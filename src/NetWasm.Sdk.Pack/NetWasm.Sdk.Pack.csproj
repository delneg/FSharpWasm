<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NetWasm.Sdk.Pack</AssemblyName>
    <RootNamespace>NetWasm.Sdk.Pack</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- Its package references are compile-time only (ExcludeAssets="runtime"):
         nothing of theirs ships or runs, so their advisories do not apply. -->
    <NuGetAudit>false</NuGetAudit>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Release task payloads are embedded in the SDK package.  Omitting
         portable PDBs keeps that payload independent of build-root paths;
         Debug remains symbol-rich for focused test and coverage builds. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <!-- Keep repository-local generated files out of default globs when the
         SDK pack invokes this internal task project with an external
         BaseIntermediateOutputPath/BaseOutputPath. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)/obj/**;$(MSBuildProjectDirectory)/bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Compile-time references only: the task runs inside the building SDK's
       MSBuild, which supplies these assemblies. Packages rather than the
       SDK's own copies, so that a newer SDK (whose copies target a newer
       runtime) still builds this net10.0 task. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Build" Version="18.0.2" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.0.2" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.0.2" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="NuGet.Packaging" Version="7.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
