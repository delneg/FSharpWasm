<Project Sdk="NetWasm.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>netwasm0.1</TargetFramework>
    <!-- Upstream measures its print-42 size with this assembly name; it affects encoded indices. -->
    <AssemblyName>NetWasmApp</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
