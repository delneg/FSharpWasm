<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Test-only MSBuild and NuGet packages. -->
    <NuGetAudit>false</NuGetAudit>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTestProject>true</IsTestProject>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NetWasm.Sdk.Pack/NetWasm.Sdk.Pack.csproj" />
    <!-- MSBuild from packages, not the building SDK's copies, which target
         the SDK's runtime (net11.0 under the .NET 11 SDK). NuGet stays the
         SDK's own, so that it reads the restore graphs that SDK writes. -->
    <PackageReference Include="Microsoft.Build" Version="18.0.2" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.0.2" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.0.2" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.0.2" />
    <Reference Include="NuGet.Versioning">
      <HintPath>$(MSBuildToolsPath)/NuGet.Versioning.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NuGet.ProjectModel">
      <HintPath>$(MSBuildToolsPath)/NuGet.ProjectModel.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NuGet.Frameworks">
      <HintPath>$(MSBuildToolsPath)/NuGet.Frameworks.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NuGet.Packaging">
      <HintPath>$(MSBuildToolsPath)/NuGet.Packaging.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
